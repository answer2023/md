# 本地开发来源白名单，覆盖 wrangler.toml 的 APP_URL（生产配置只列线上域名）
APP_URL=http://localhost:5173,https://md.tangzhihong.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=
AFDIAN_API_TOKEN=
# 可选：爱发电 Webhook 路径密钥。配置后回调地址为 /webhooks/afdian/<token>
AFDIAN_WEBHOOK_TOKEN=
# 默认图床 GitHub PAT，逗号分隔
UPLOAD_GITHUB_TOKENS_BUCKETIO=
# 主题/组件市场审核管理员（GitHub login，逗号分隔）
ADMIN_GITHUB_LOGINS=
