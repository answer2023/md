# Long-term caching for content-hashed build artifacts (Workers static assets).
# Only /static/* carries a content hash (see vite.config.ts assetFileNames), so it is the
# only safe target for immutable. Everything else — index.html and the stable-named files
# under /assets/ such as the WeChat QR — keeps the platform default (revalidate), so
# replacing an image under the same filename reaches returning visitors immediately.
/static/*
  Cache-Control: public, max-age=31536000, immutable
